# Copy to .env and fill in only what you need.

# Where the database, uploads, renders, and samples live.
# PAPERPROOF_DATA_DIR=./data

# Server bind. Keep this on localhost unless you add auth.
# PAPERPROOF_HOST=127.0.0.1
# PAPERPROOF_PORT=8000

# Extraction mode: auto | rules | llm
# auto uses the LLM when a base URL is configured, otherwise rules.
# PAPERPROOF_EXTRACTOR=auto

# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, vLLM, Ollama.
# Leave blank for the offline rule baseline.
# PAPERPROOF_LLM_BASE_URL=https://api.openai.com/v1
# PAPERPROOF_LLM_API_KEY=sk-replace-me
# PAPERPROOF_LLM_MODEL=gpt-4.1-mini

# OCR. Scans are read locally with Tesseract.
# PAPERPROOF_OCR=auto
# PAPERPROOF_OCR_DPI=300
# PAPERPROOF_OCR_MIN_CHARS=40
# PAPERPROOF_OCR_LOW_CONFIDENCE=60

# Authentication. Set to prod behind TLS.
# PAPERPROOF_ENV=dev
# PAPERPROOF_SESSION_SECRET=replace-with-at-least-32-random-bytes
# PAPERPROOF_SESSION_TTL_SECONDS=43200
# PAPERPROOF_LOGIN_MAX_ATTEMPTS=5
# PAPERPROOF_LOGIN_WINDOW_SECONDS=300
# PAPERPROOF_LOGIN_LOCKOUT_SECONDS=300

# Only for local development. Never with PAPERPROOF_ENV=prod.
# PAPERPROOF_AUTH_DISABLED=0

# Retrieval knobs.
# PAPERPROOF_TOP_K=6
# PAPERPROOF_CANDIDATE_K=48
# PAPERPROOF_CHUNK_CHARS=900
# PAPERPROOF_CHUNK_OVERLAP_CHARS=160
